EXECUTE alterIfNotExists;
DEALLOCATE PREPARE alterIfNotExists;

-- Migrate existing S2S Direct campaigns
UPDATE `integration_tools` SET `integration_method` = 's2s_direct' WHERE `s2s_enabled` = 1 AND `s2s_direct_mode` = 1 AND `integration_method` = 'js_pixel';

-- Migrate existing S2S campaigns
UPDATE `integration_tools` SET `integration_method` = 's2s' WHERE `s2s_enabled` = 1 AND `s2s_direct_mode` = 0 AND `integration_method` = 'js_pixel';

-- Migrate existing Postback campaigns
UPDATE `integration_tools` SET `integration_method` = 'postback' WHERE `marketpostback` LIKE '%"status":"custom"%' AND `integration_method` = 'js_pixel';

/* Email Templates Module Upgrade 2026 - Phase 1 & 5 */
UPDATE `mail_templates` SET `unique_id` = 'forget_password' WHERE `id` = 3 AND (`unique_id` = '' OR `unique_id` IS NULL);

UPDATE `mail_templates` SET `text` = REPLACE(`text`, 'password rest', 'password reset'), `admin_text` = REPLACE(COALESCE(`admin_text`,''), 'password rest', 'password reset'), `client_text` = REPLACE(COALESCE(`client_text`,''), 'password rest', 'password reset') WHERE `id` = 3;

UPDATE `mail_templates` SET `text` = '<p>Dear [[firstname]],</p>\r\n<p>Your subscription for plan <strong>[[planname]]</strong> will expire soon.</p>\r\n<p>Expiry Date: [[expire_at]]</p>\r\n<p>Please renew to continue enjoying our services.</p>\r\n<p><br />[[website_name]]<br />Support Team</p>' WHERE `unique_id` = 'subscription_expire_notification' AND (`text` = '<p>customText</p>\r\n' OR `text` LIKE '%customText%');

UPDATE `mail_templates` SET `text` = '<h2>Thanks for your order</h2>\r\n\r\n<p>Dear [[firstname]],</p>\r\n<p>Welcome to [[website_name]]. Your subscription for <strong>[[planname]]</strong> has been activated.</p>\r\n<p>Price: [[price]] | Valid until: [[expire_at]]</p>\r\n<p>If you have any questions, simply reply to this email.</p>\r\n<p><br />[[website_name]]<br />Support Team</p>', `admin_text` = '<h2>New Subscription Purchase</h2>\r\n<p>[[firstname]] [[lastname]] purchased subscription: [[planname]]</p>\r\n<p>Price: [[price]] | User: [[email]]</p>\r\n<p><br />[[website_name]]<br />Support Team</p>' WHERE `unique_id` = 'subscription_buy' AND (`text` LIKE '%customText%' OR `admin_text` LIKE '%customText%');

CREATE TABLE IF NOT EXISTS `email_logs` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `recipient` varchar(255) NOT NULL,
  `subject` varchar(500) NOT NULL,
  `template_id` int(11) DEFAULT NULL,
  `template_unique_id` varchar(100) DEFAULT NULL,
  `status` enum('sent','failed','queued') NOT NULL DEFAULT 'sent',
  `error_message` text DEFAULT NULL,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_recipient` (`recipient`),
  KEY `idx_status` (`status`),
  KEY `idx_created_at` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

