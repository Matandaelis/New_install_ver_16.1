-- Add unified payment details table for custom payment gateways
CREATE TABLE IF NOT EXISTS `user_payment_details` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `user_id` int(11) NOT NULL,
  `gateway_code` varchar(50) NOT NULL,
  `field_name` varchar(100) NOT NULL,
  `field_value` text,
  `created_date` datetime DEFAULT CURRENT_TIMESTAMP,
  `updated_date` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `user_gateway_field` (`user_id`, `gateway_code`, `field_name`),
  KEY `user_gateway` (`user_id`, `gateway_code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Increase target_link column size for Stripe checkout URLs (longer than 255 chars)
ALTER TABLE `integration_tools` MODIFY `target_link` VARCHAR(500) NOT NULL;

-- Create table to store Stripe session affiliate tracking
CREATE TABLE IF NOT EXISTS `stripe_sessions` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `session_id` varchar(255) NOT NULL,
  `campaign_id` int(11) NOT NULL,
  `affiliate_id` varchar(255) NOT NULL,
  `created_at` datetime NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `session_id` (`session_id`),
  KEY `campaign_id` (`campaign_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

