-- Optional seed roles. Admins can create, edit and delete roles via Admin Panel → Users → Manage Roles.
INSERT IGNORE INTO `admin_roles` (`id`, `name`, `slug`, `permissions`, `created_at`) VALUES
(1, 'Finance Admin', 'finance', '["dashboard","analytics","reports","reports.orders","reports.transactions","reports.wallet","reports.statistics","settings","settings.payment","marketing.deposits"]', NOW()),
(2, 'Support Admin', 'support', '["dashboard","users","reports","reports.orders","reports.statistics"]', NOW()),
(3, 'Marketing Admin', 'marketing', '["dashboard","analytics","marketing","marketing.deposits","marketing.campaigns","reports","reports.orders","reports.statistics"]', NOW());

-- Migrate language flag paths from retired assets/vertical to assets/template/images/flags
UPDATE `language` SET `flag` = REPLACE(`flag`, './assets/vertical/assets/images/flags/', 'assets/template/images/flags/') WHERE `flag` LIKE '%assets/vertical/assets/images/flags/%';
UPDATE `language` SET `flag` = REPLACE(`flag`, 'assets/vertical/assets/images/flags/', 'assets/template/images/flags/') WHERE `flag` LIKE '%assets/vertical/assets/images/flags/%';
-- Strip leading ./ from paths stored by the language editor (glob adds ./ prefix)
UPDATE `language` SET `flag` = SUBSTRING(`flag`, 3) WHERE `flag` LIKE './%' AND `flag` != '';
-- Normalise bare filenames (e.g. mp.png → assets/template/images/flags/mp.png)
UPDATE `language` SET `flag` = CONCAT('assets/template/images/flags/', `flag`) WHERE `flag` != '' AND `flag` IS NOT NULL AND `flag` NOT LIKE '%/%' AND `flag` NOT LIKE 'http%';
-- Fix wrong country flag assignments caused by old broken auto-detection logic
-- (old code matched language names against country names like 'united-states'/'portugal'
--  but flag files use ISO 3166-1 alpha-2 codes, so it fell back to wrong accidental matches)
UPDATE `language` SET `flag` = 'assets/template/images/flags/us.png' WHERE `name` = 'English'    AND `flag` LIKE '%/lr.png';
UPDATE `language` SET `flag` = 'assets/template/images/flags/pt.png' WHERE `name` = 'Portuguese' AND `flag` LIKE '%/ao.png';

/* Mass payout export (PayPal / Wise batch CSV) — links wallet_requests to payout_batches for reconciliation */
CREATE TABLE IF NOT EXISTS `payout_batches` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `created_by_admin_id` int(11) DEFAULT NULL,
  `processor` varchar(20) NOT NULL,
  `currency_code` varchar(10) NOT NULL DEFAULT 'USD',
  `row_count` int(11) NOT NULL DEFAULT 0,
  `total_amount` decimal(16,4) NOT NULL DEFAULT 0.0000,
  `status` varchar(20) NOT NULL DEFAULT 'exported',
  `created_at` datetime NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_pb_created` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS `payout_batch_items` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `batch_id` int(11) NOT NULL,
  `wallet_request_id` int(11) NOT NULL,
  `amount` double NOT NULL,
  `receiver_snapshot` varchar(255) NOT NULL,
  `reconciliation_status` varchar(20) NOT NULL DEFAULT 'pending',
  `reconciliation_detail` text DEFAULT NULL,
  `reconciliation_at` datetime DEFAULT NULL,
  `provider_txn_id` varchar(300) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_pbi_batch_wr` (`batch_id`,`wallet_request_id`),
  KEY `idx_pbi_batch` (`batch_id`),
  KEY `idx_pbi_wr` (`wallet_request_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

SET @preparedStatement = (
  SELECT IF((SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE (table_name = "wallet_requests") AND (table_schema = @databaseName) AND (column_name = "batch_export_id")) > 0,
  "SELECT 1",
  CONCAT("ALTER TABLE `wallet_requests` ADD COLUMN `batch_export_id` int(11) DEFAULT NULL AFTER `created_at`;")
));
PREPARE alterIfNotExists FROM @preparedStatement;
EXECUTE alterIfNotExists;
DEALLOCATE PREPARE alterIfNotExists;

