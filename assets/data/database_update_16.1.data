-- Phase 1B: Abandoned Cart Recovery table
CREATE TABLE IF NOT EXISTS `abandoned_carts` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `user_id` INT NULL DEFAULT NULL,
  `session_id` VARCHAR(128) NULL DEFAULT NULL,
  `email` VARCHAR(255) NULL DEFAULT NULL,
  `cart_data` TEXT NULL,
  `recovery_token` VARCHAR(64) NULL DEFAULT NULL,
  `status` ENUM('abandoned','recovered','expired') NOT NULL DEFAULT 'abandoned',
  `reminder_count` INT NOT NULL DEFAULT 0,
  `reminder_sent_at` DATETIME NULL DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `recovered_at` DATETIME NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  INDEX `idx_ac_status` (`status`),
  INDEX `idx_ac_token` (`recovery_token`),
  INDEX `idx_ac_email` (`email`),
  INDEX `idx_ac_created` (`created_at`)
) ENGINE = InnoDB CHARACTER SET = utf8 COLLATE = utf8_unicode_ci;

-- Phase 3B: Vendor Payouts table
CREATE TABLE IF NOT EXISTS `vendor_payouts` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `vendor_id` INT NOT NULL,
  `amount` DOUBLE NOT NULL DEFAULT 0,
  `currency` VARCHAR(10) NOT NULL DEFAULT 'USD',
  `method` VARCHAR(50) NOT NULL DEFAULT 'bank',
  `status` ENUM('pending','approved','denied','paid') NOT NULL DEFAULT 'pending',
  `reference` VARCHAR(255) NULL DEFAULT NULL,
  `vendor_note` TEXT NULL,
  `admin_note` TEXT NULL,
  `requested_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `processed_at` DATETIME NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  INDEX `idx_vp_vendor` (`vendor_id`),
  INDEX `idx_vp_status` (`status`)
) ENGINE = InnoDB CHARACTER SET = utf8 COLLATE = utf8_unicode_ci;

-- Phase 3D: Store Messages table
CREATE TABLE IF NOT EXISTS `store_messages` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `order_id` INT NOT NULL,
  `sender_id` INT NOT NULL,
  `sender_type` ENUM('customer','vendor','admin') NOT NULL DEFAULT 'customer',
  `message` TEXT NOT NULL,
  `is_read` TINYINT(1) NOT NULL DEFAULT 0,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  INDEX `idx_sm_order` (`order_id`),
  INDEX `idx_sm_sender` (`sender_id`)
) ENGINE = InnoDB CHARACTER SET = utf8 COLLATE = utf8_unicode_ci;

-- Phase 4B: Stock history log table
CREATE TABLE IF NOT EXISTS `stock_history` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `product_id` INT NOT NULL,
  `quantity_change` INT NOT NULL DEFAULT 0,
  `quantity_after` INT NOT NULL DEFAULT 0,
  `reason` VARCHAR(100) NOT NULL DEFAULT 'manual',
  `reference_id` INT NULL DEFAULT NULL,
  `user_id` INT NULL DEFAULT NULL,
  `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  INDEX `idx_sh_product` (`product_id`),
  INDEX `idx_sh_created` (`created_at`)
) ENGINE = InnoDB CHARACTER SET = utf8 COLLATE = utf8_unicode_ci;

