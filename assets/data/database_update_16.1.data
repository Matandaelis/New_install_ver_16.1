-- Lifetime Commission setting (disabled by default)
INSERT INTO `setting` (`setting_key`, `setting_value`, `setting_type`, `setting_status`, `setting_ipaddress`, `setting_is_default`, `language_id`)
SELECT 'lifetime_commission', '0', 'store', 1, '', 0, 1
FROM DUAL
WHERE NOT EXISTS (SELECT 1 FROM `setting` WHERE `setting_key` = 'lifetime_commission' AND `setting_type` = 'store');

-- Integration Method column for Integration Setup Wizard
SET @preparedStatement = (
  SELECT IF((SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE (table_name = "integration_tools") AND (table_schema = @databaseName) AND (column_name = "integration_method")) > 0,
  "SELECT 1",
  CONCAT("ALTER TABLE `integration_tools` ADD COLUMN `integration_method` VARCHAR(20) NOT NULL DEFAULT 'js_pixel' AFTER `s2s_direct_mode`;")
));
